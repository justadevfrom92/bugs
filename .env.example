APP_NAME="Energy Texas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Brand (shown on the website and admin)
BRAND_NAME="Energy Texas"
BRAND_PHONE="1-800-555-0100"
BRAND_PHONE_HREF="tel:18005550100"
BRAND_PUCT=XXXXX

# Password for the demo users created by `php artisan db:seed`. Change it, or
# remove the demo users, before going live.
ADMIN_DEMO_PASSWORD=password

# Integrations (Sheriff → APIs shows whether each is set; values are never displayed)
AIG_ENDPOINT=
AIG_PARTNER_ID=
AIG_API_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
AUTHNET_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
IBM_WEATHER_ENDPOINT=
IBM_WEATHER_API_KEY=
INNOWATTS_ENDPOINT=
INNOWATTS_CLIENT_ID=
INNOWATTS_CLIENT_SECRET=
EXPERIAN_ENDPOINT=
EXPERIAN_SUBSCRIBER_CODE=
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=
PLAID_ENV=
PLAID_CLIENT_ID=
PLAID_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
SALESFORCE_SUBDOMAIN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
UTILIBILL_ENDPOINT=
UTILIBILL_USERNAME=
UTILIBILL_PASSWORD=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
